<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="..\..\template.targets"/>

    <PropertyGroup>
        <AssemblyName>MyPotWorld</AssemblyName>
        <RootNamespace>MyPotWorld</RootNamespace>
        <Version>0.6.2</Version>
    </PropertyGroup>

    <!-- 只依赖【契约程序集】：核心实现升级不必重编玩法；契约 DLL 由核心模块的 lib/ 提供 -->
    <ItemGroup>
        <ProjectReference Include="..\VirtualWorldCore.Abstractions\VirtualWorldCore.Abstractions.csproj">
            <Private>false</Private>
            <ExcludeAssets>runtime</ExcludeAssets>
        </ProjectReference>
    </ItemGroup>

</Project>
